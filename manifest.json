{
  "azphalt": "0.1",
  "id": "com.hereliesaz.azphalt.rotate-snap",
  "name": "Rotate Snap",
  "version": "1.2.0",
  "kind": "asset",
  "license": "LicenseRef-Proprietary",
  "compat": ">=0.1",
